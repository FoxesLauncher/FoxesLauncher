<Grid x:Class="MyMsgRegionLanguage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:my="clr-namespace:FXL"
             RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="TransformRotate" Angle="-4" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushDialog}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObjectShadow}" BlurRadius="20" ShadowDepth="4" RenderingBias="Performance" Opacity="0.8" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,-1,70,9">
                <!-- 地球图标：声明这是区域与语言设置 -->
                <Path x:Name="IconTitle" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"
                      Fill="{DynamicResource ColorBrush2}"
                      Data="F1 M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M11,19.93 C7.06,19.44 4,16.08 4,12 C4,11.38 4.08,10.79 4.21,10.21 L9,15 L9,16 C9,17.1 9.9,18 11,18 L11,19.93 Z M17.9,17.39 C17.64,16.58 16.9,16 16,16 L15,16 L15,13 C15,12.45 14.55,12 14,12 L8,12 L8,10 L10,10 C10.55,10 11,9.55 11,9 L11,7 L13,7 C14.1,7 15,6.1 15,5 L15,4.59 C17.93,5.78 20,8.65 20,12 C20,14.08 19.2,15.97 17.9,17.39 Z" />
                <TextBlock FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" Name="LabTitle" Text="{DynamicResource 区域与语言}" VerticalAlignment="Center" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            </StackPanel>
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <StackPanel Grid.Row="3" Margin="7,0,7,17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 地图图标：声明这是区域设置 -->
                        <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                              Fill="{DynamicResource ColorBrush4}"
                              Data="F1 M20.5,3 L20.34,3.03 L15,5.1 L9,3 L3.38,4.9 C3.15,4.98 3,5.19 3,5.43 L3,21 L3.16,20.97 L9,18.9 L15,21 L20.62,19.1 C20.85,19.02 21,18.81 21,18.57 L21,3.5 C21,3.22 20.78,3 20.5,3 Z M15,19 L9,16.89 L9,5 L15,7.11 L15,19 Z" />
                        <TextBlock x:Name="LabRegion" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource 区域}" Margin="0,0,20,0" />
                    </StackPanel>
                    <my:MyComboBox x:Name="ComboRegion" Grid.Column="1" HorizontalAlignment="Left" Width="280" />
                    <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Center">
                        <!-- 翻译图标：声明这是语言设置 -->
                        <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                              Fill="{DynamicResource ColorBrush4}"
                              Data="F1 M12.87,15.07 L10.33,12.56 L10.36,12.53 C12.1,10.59 13.34,8.36 14.07,6 L17,6 L17,4 L10,4 L10,2 L8,2 L8,4 L1,4 L1,5.99 L12.17,5.99 C11.5,7.92 10.44,9.75 9,11.35 C8.07,10.32 7.3,9.19 6.69,8 L4.69,8 C5.42,9.63 6.42,11.17 7.67,12.56 L2.58,17.58 L4,19 L9,14 L12.11,17.11 L12.87,15.07 Z M18.5,10 L16.5,10 L12,22 L14,22 L15.12,19 L19.87,19 L21,22 L23,22 L18.5,10 Z M15.88,17 L17.5,12.67 L19.12,17 L15.88,17 Z" />
                        <TextBlock x:Name="LabLanguage" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource 语言}" Margin="0,0,20,0" />
                    </StackPanel>
                    <my:MyComboBox x:Name="ComboLanguage" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="280" />
                    <TextBlock x:Name="LabHint" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.55"
                               Foreground="{DynamicResource ColorBrushGray2}"
                               Text="{DynamicResource 更改界面语言后需要重启启动器才能完全生效。}" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="4" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="150,0,8,0" Orientation="Horizontal">
                <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="{DynamicResource 确定}" x:Name="Btn1" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
