<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FXL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadResourcePack"
    PanScroll="Content">
    <local:PageResource x:Name="Content" PageType="ResourcePack" TypeName="{DynamicResource 资源包}" TypeNameSpaced="{DynamicResource 资源包}">
        <local:MyComboBoxItem Tag="" Content="{DynamicResource 全部}" IsSelected="True" />

        <local:MyComboBoxItem Content="{DynamicResource 风格}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 原版风}" Tag="403/vanilla-like" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 写实风}" Tag="400/realistic" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 现代风}" Tag="401/" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 中世纪}" Tag="402/" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 蒸汽朋克}" Tag="399/" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 主题化}" Tag="/themed" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 简洁}" Tag="/simplistic" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 装饰}" Tag="/decoration" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 战斗}" Tag="/combat" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 实用}" Tag="/utility" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 改良}" Tag="/tweaks" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 鬼畜}" Tag="/cursed" />

        <local:MyComboBoxItem Content="{DynamicResource 特性}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 含实体}" Tag="/entities" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 含声音}" Tag="/audio" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 含字体}" Tag="5244/fonts" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 含模型}" Tag="/models" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 含语言}" Tag="/locale" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 含 UI}" Tag="/gui" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 核心着色器}" Tag="/core-shaders" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 动态效果}" Tag="404/" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 兼容 Mod}" Tag="4465/modded" />

        <local:MyComboBoxItem Content="{DynamicResource 分辨率}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 8x 或更低}" Tag="/8x-" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="16x" Tag="393/16x" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="32x" Tag="394/32x" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="48x" Tag="/48x" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="64x" Tag="395/64x" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="128x" Tag="396/128x" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="256x" Tag="397/256x" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 512x 或更高}" Tag="398/512x+" />
    </local:PageResource>
</local:MyPageRight>
