<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FXL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadShader"
    PanScroll="Content">
    <local:PageResource x:Name="Content" PageType="Shader" TypeName="{DynamicResource 光影包}" TypeNameSpaced="{DynamicResource 光影包}">
        <local:MyComboBoxItem Tag="" Content="{DynamicResource 全部}" IsSelected="True" />

        <local:MyComboBoxItem Content="{DynamicResource 风格}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 原版风}" Tag="6555/vanilla-like" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 幻想风}" Tag="6554/fantasy" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 写实风}" Tag="6553/realistic" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 半写实风}" Tag="/semi-realistic" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 卡通风}" Tag="/cartoon" />

        <local:MyComboBoxItem Content="{DynamicResource 特性}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 彩色光照}" Tag="/colored-lighting" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 路径追踪}" Tag="/path-tracing" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="PBR" Tag="/pbr" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 反射}" Tag="/reflections" />

        <local:MyComboBoxItem Content="{DynamicResource 性能负荷}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 极低}" Tag="/potato" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 低}" Tag="/low" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 中}" Tag="/medium" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 高}" Tag="/high" />

        <local:MyComboBoxItem Content="{DynamicResource 加载器}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource 原版可用}" Tag="/vanilla" ToolTip="{DynamicResource 作为资源包加载，可以直接在原版游戏里使用。}" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="Iris" Tag="/iris" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="OptiFine" Tag="/optifine" />
    </local:PageResource>
</local:MyPageRight>
