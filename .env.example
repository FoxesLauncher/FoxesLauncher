# ============================================================================
# FoxesLauncher 本地构建配置示例
#
# 使用方法：
#   1. 将本文件复制为仓库根目录的 .env
#   2. 按需填写下面的值；留空则使用默认值
#   3. 重新构建项目，构建脚本会生成 Modules\GeneratedSecrets.vb
#
# 构建环境变量优先于 .env 中的同名配置，方便 CI 注入 secrets。
# ============================================================================

# 分支标识。开源版填 OpenSource，正式版/官方分支填 Official。
# 该值会参与更新、联网配置、主题等功能是否可用的判断。
PCL_VERSION_BRANCH=OpenSource

# 注册表隔离目录，用于避免不同分支的设置互相覆盖。
# 留空时：PCL_VERSION_BRANCH=Official 使用 PCL，其他情况使用 PCLDebug。
# PCL_REG_FOLDER=PCLDebug

# 微软正版登录使用的 OAuth Client ID
PCL_MS_CLIENT_ID=

# CurseForge API Key
PCL_CURSEFORGE_API_KEY=

# 匿名数据收集的日志服务上报地址
# 形如：https://{region}.cls.tencentcs.com/track?topic_id={topic_id}
# 留空则关闭遥测上报。
PCL_CLS_BASE_URL=

# 构建对应的 Commit Hash。留空时构建脚本会尝试从当前 Git 仓库读取。
# PCL_COMMIT_HASH=
