# ============================================================================
# FoxesLauncher 本地构建配置示例
#
# 使用方法：
#   1. 将本文件复制为仓库根目录的 .env
#   2. 按需填写下面的值；留空则使用默认值
#   3. 重新构建项目，构建脚本会生成 Modules\GeneratedSecrets.vb
#
# 构建环境变量优先于 .env 中的同名配置，方便 CI 注入 secrets。
# ============================================================================

# 分支标识。开源版填 OpenSource，正式版/官方分支填 Official。
# 该值会参与更新、联网配置、主题等功能是否可用的判断。
FXL_VERSION_BRANCH=OpenSource

# 注册表隔离目录，用于避免不同分支的设置互相覆盖。
# 留空时：FXL_VERSION_BRANCH=Official 使用 FXL，其他情况使用 FXLDebug。
# FXL_REG_FOLDER=FXLDebug

# 微软正版登录使用的 OAuth Client ID
FXL_MS_CLIENT_ID=

# CurseForge API Key
FXL_CURSEFORGE_API_KEY=

# 匿名数据收集的日志服务上报地址
# 形如：https://{region}.cls.tencentcs.com/track?topic_id={topic_id}
# 留空则关闭遥测上报。
FXL_CLS_BASE_URL=

# 构建对应的 Commit Hash。留空时构建脚本会尝试从当前 Git 仓库读取。
# FXL_COMMIT_HASH=

# ----------------------------------------------------------------------------
# 更新、公告与遥测（FoxesLauncher 远程服务）
#
# 所有地址、公钥都在这里配置，不要写进代码。留空的项会安全地关闭对应功能。
# 更新 manifest / 公告 / 动态配置都是“信封”格式：
#   { "payload": "base64(...)", "signature": { "alg": "RS256", "keyId": "...", "value": "base64(...)" } }
# payload 是被签名的原始 JSON 字节的 Base64，客户端先验签再解析。
# ----------------------------------------------------------------------------

# 更新通道：official / snapshot / open-source
FXL_UPDATE_CHANNEL=official
# manifest 平台标识
FXL_UPDATE_PLATFORM=win-x64

# Cloudflare R2 的 manifest 地址模板，可用 {channel}、{platform} 占位
# 示例：https://fxlup.example.com/update/{channel}/{platform}/latest.json
FXL_UPDATE_R2_LATEST=
# GitHub Release 的 latest.json 静态直链
# 示例：https://github.com/owner/repo/releases/latest/download/latest.json
FXL_UPDATE_GITHUB_LATEST=
# GitCode Release 的 latest.json 直链（确认格式后再填写；留空则跳过该源）
FXL_UPDATE_GITCODE_LATEST=
FXL_UPDATE_GITCODE_API_LATEST=https://api.gitcode.com/api/v5/repos/FoxesLauncher/FoxesLauncher/releases/latest

# 签名公告 JSON（Cloudflare R2），可附加逗号分隔的备用地址
FXL_UPDATE_NOTICES_URL=
FXL_UPDATE_NOTICES_FALLBACK_URLS=

# 签名动态配置 JSON（联机等配置）
FXL_UPDATE_CONFIG_URL=

# 遥测批量上报地址（Cloudflare Worker）；留空则关闭遥测
# 示例：https://fxlapi.example.com/v1/telemetry
FXL_TELEMETRY_URL=
# 遥测批量发送间隔（秒，最小 5）
FXL_TELEMETRY_INTERVAL_SECONDS=15

# 发布公钥。格式：keyId=base64(RSA 公钥 XML)，多个用分号分隔。
# 由 release/scripts/generate-keys.ps1 自动写入；私钥不要放在仓库内。
FXL_UPDATE_PUBLIC_KEYS=

# 期望的 Authenticode 证书指纹（留空则跳过该检查）
FXL_UPDATE_AUTHENTICODE_THUMBPRINT=

# TLS 软钉扎允许的根/中间 CA 指纹（分号分隔；留空则不告警）
FXL_TLS_PINNED_CA_THUMBPRINTS=
